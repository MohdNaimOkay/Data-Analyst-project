Which occupation has the highest and lowest average sleep duration?
select occupation, round(avg(sleep_duration_hrs),2) as "sleep Hours per day"
from health_dataset
group by occupation 
order by avg(sleep_duration_hrs) desc

How does stress level affect sleep quality?
select occupation, round(avg(sleep_quality_score),2) as "sleep quality", round(avg(stress_score),2) as "stress level"
from health_dataset
group by occupation
order by avg(stress_score) desc

Does screen time before bed impact sleep quality?
select occupation , round(avg(screen_time_before_bed_mins),2) as "screen_time in mins", round(avg(sleep_quality_score),2) as "sleep_quality" 
from health_dataset
group by occupation
order by avg(sleep_quality_score) desc
